# Copie para .env e preencha. NUNCA versione o .env.
# Gere a chave com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=''
DJANGO_DEBUG=False
# Endereços pelos quais o painel será acessado (separados por vírgula)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Só se o painel ficar atrás de HTTPS/proxy, ex.: https://painel.empresa.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=

PUZZLE_BASE_URL=https://hipertrade-puzzle-op.techtd.com.br
# Use um usuário EXCLUSIVO do robô: o Puzzle mantém uma sessão por usuário
# (um novo login derruba a sessão anterior).
PUZZLE_USER=
PUZZLE_PASS=
# False abre o navegador na tela durante a execução dos reagendamentos
PUZZLE_HEADLESS=True
